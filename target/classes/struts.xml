<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.5//EN"
        "http://struts.apache.org/dtds/struts-2.5.dtd">

<struts>

    <!-- 开发模式：生产环境改为 false -->
    <constant name="struts.devMode" value="true"/>
    <!-- 由 Spring 负责创建 Action 实例 -->
    <constant name="struts.objectFactory" value="spring"/>
    <!-- Action 实例每次请求都交给 Spring 容器管理（配合 spring plugin） -->
    <constant name="struts.objectFactory.spring.autoWire" value="name"/>
    <constant name="struts.objectFactory.spring.useClassCache" value="true"/>
    <!-- 请求后缀 -->
    <constant name="struts.action.extension" value="action,do,"/>
    <!-- 编码 -->
    <constant name="struts.i18n.encoding" value="UTF-8"/>
    <!-- 国际化资源 -->
    <constant name="struts.custom.i18n.resources" value="i18n/messages"/>
    <!-- 上传文件大小上限（50MB） -->
    <constant name="struts.multipart.maxSize" value="52428800"/>
    <!-- 开启动态方法调用 -->
    <constant name="struts.enable.DynamicMethodInvocation" value="true"/>

    <package name="default" extends="struts-default,json-default" namespace="/">

        <!-- ===== 拦截器：认证 + 授权 ===== -->
        <interceptors>
            <interceptor name="auth" class="com.yourname.interceptor.AuthInterceptor"/>
            <interceptor name="operLog" class="com.yourname.interceptor.OperLogInterceptor"/>
            <!-- 需要登录后才能访问的 Action 使用此栈 -->
            <interceptor-stack name="authStack">
                <interceptor-ref name="auth"/>
                <!-- 登录后才会记录操作日志：只记录带 @OperLog 的方法 -->
                <interceptor-ref name="operLog"/>
                <interceptor-ref name="defaultStack"/>
            </interceptor-stack>
        </interceptors>

        <!-- 全局结果 -->
        <global-results>
            <result name="error">/WEB-INF/jsp/common/error.jsp</result>
            <result name="login">/WEB-INF/jsp/login.jsp</result>
            <result name="unauthorized">/WEB-INF/jsp/common/403.jsp</result>
        </global-results>

        <global-exception-mappings>
            <exception-mapping exception="java.lang.Exception" result="error"/>
        </global-exception-mappings>

        <!--
            Action 由 Spring 管理时，class 属性写 Spring 容器中的 Bean 名称。
            示例：
            <action name="user_*" class="userAction" method="{1}">
                <result name="list">/WEB-INF/jsp/system/user/list.jsp</result>
                <result name="success" type="redirectAction">user_list</result>
            </action>
        -->

        <!-- ===== 启动自检最小闭环 ===== -->
        <action name="login_input" class="com.yourname.action.LoginAction" method="input">
            <result name="input">/WEB-INF/jsp/login.jsp</result>
            <result name="success" type="redirectAction">index</result>
        </action>

        <action name="login" class="com.yourname.action.LoginAction" method="login">
            <result name="input">/WEB-INF/jsp/login.jsp</result>
            <result name="success" type="redirectAction">index</result>
        </action>

        <action name="logout" class="com.yourname.action.LoginAction" method="logout">
            <result name="success" type="redirectAction">login_input</result>
        </action>

        <action name="register_input" class="com.yourname.action.RegisterAction" method="input">
            <result name="input">/WEB-INF/jsp/register.jsp</result>
        </action>

        <action name="register" class="com.yourname.action.RegisterAction" method="register">
            <result name="input">/WEB-INF/jsp/register.jsp</result>
            <result name="success" type="redirectAction">login_input</result>
        </action>

        <action name="index" class="com.yourname.action.IndexAction">
            <interceptor-ref name="authStack"/>
            <result name="login" type="redirectAction">login_input</result>
            <result>/WEB-INF/jsp/index.jsp</result>
        </action>

        <!-- ===== 用户管理（权限由 @RequiresPermissions 在服务端校验） ===== -->
        <action name="user_list" class="com.yourname.action.UserManageAction" method="list">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/user/list.jsp</result>
        </action>

        <action name="user_role_input" class="com.yourname.action.UserManageAction" method="roleInput">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/user/user_role.jsp</result>
            <result name="input" type="redirectAction">
                <param name="actionName">user_list</param>
            </result>
        </action>

        <action name="user_status_save" class="com.yourname.action.UserManageAction" method="changeStatus">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">user_list</result>
            <result name="input" type="redirectAction">user_list</result>
        </action>

        <action name="user_role_save" class="com.yourname.action.UserManageAction" method="roleSave">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">user_list</result>
            <result name="input" type="redirectAction">
                <param name="actionName">user_list</param>
            </result>
        </action>

        <!-- ===== 角色管理 ===== -->
        <action name="role_list" class="com.yourname.action.RoleManageAction" method="list">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/role/list.jsp</result>
            <result name="input">/WEB-INF/jsp/system/role/list.jsp</result>
        </action>

        <action name="role_input" class="com.yourname.action.RoleManageAction" method="input">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/role/role_edit.jsp</result>
            <result name="input" type="redirectAction">
                <param name="actionName">role_list</param>
            </result>
        </action>

        <action name="role_save" class="com.yourname.action.RoleManageAction" method="save">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">role_list</result>
            <result name="input">/WEB-INF/jsp/system/role/role_edit.jsp</result>
        </action>

        <action name="role_delete" class="com.yourname.action.RoleManageAction" method="delete">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">role_list</result>
            <result name="input">/WEB-INF/jsp/system/role/list.jsp</result>
        </action>

        <!-- ===== 文件管理 ===== -->
        <action name="file_list" class="com.yourname.action.FileAction" method="list">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/file/list.jsp</result>
        </action>

        <action name="file_upload" class="com.yourname.action.FileAction" method="upload">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">file_list</result>
            <result name="input" type="redirectAction">file_list</result>
        </action>

        <action name="file_delete" class="com.yourname.action.FileAction" method="delete">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">file_list</result>
            <result name="input" type="redirectAction">file_list</result>
        </action>

        <action name="file_download" class="com.yourname.action.FileAction" method="download">
            <interceptor-ref name="authStack"/>
            <result name="download" type="stream">
                <param name="contentType">application/octet-stream</param>
                <param name="inputName">inputStream</param>
                <param name="contentDisposition">attachment;filename*=UTF-8''${downloadFileName}</param>
                <param name="bufferSize">4096</param>
            </result>
            <result name="error" type="redirectAction">file_list</result>
        </action>

        <!-- ===== 通知公告 ===== -->
        <action name="notice_list" class="com.yourname.action.NoticeAction" method="list">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/notice/list.jsp</result>
        </action>

        <action name="notice_detail" class="com.yourname.action.NoticeAction" method="detail">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/notice/notice_detail.jsp</result>
            <result name="input">/WEB-INF/jsp/system/notice/notice_detail.jsp</result>
        </action>

        <action name="notice_view" class="com.yourname.action.NoticeAction" method="view">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/notice/view.jsp</result>
        </action>

        <action name="notice_input" class="com.yourname.action.NoticeAction" method="input">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/notice/notice_edit.jsp</result>
            <result name="input" type="redirectAction">notice_list</result>
        </action>

        <action name="notice_save" class="com.yourname.action.NoticeAction" method="save">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">notice_list</result>
            <result name="input">/WEB-INF/jsp/system/notice/notice_edit.jsp</result>
        </action>

        <action name="notice_delete" class="com.yourname.action.NoticeAction" method="delete">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">notice_list</result>
            <result name="input" type="redirectAction">notice_list</result>
        </action>

        <!-- ===== 菜单管理 ===== -->
        <action name="menu_list" class="com.yourname.action.MenuManageAction" method="list">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/menu/list.jsp</result>
        </action>

        <action name="menu_input" class="com.yourname.action.MenuManageAction" method="input">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/menu/menu_edit.jsp</result>
            <result name="input" type="redirectAction">menu_list</result>
        </action>

        <action name="menu_save" class="com.yourname.action.MenuManageAction" method="save">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">menu_list</result>
            <result name="input">/WEB-INF/jsp/system/menu/menu_edit.jsp</result>
        </action>

        <action name="menu_delete" class="com.yourname.action.MenuManageAction" method="delete">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">menu_list</result>
            <result name="input" type="redirectAction">menu_list</result>
        </action>

        <!-- ===== 部门管理 ===== -->
        <action name="dept_list" class="com.yourname.action.DeptManageAction" method="list">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/dept/list.jsp</result>
        </action>

        <action name="dept_input" class="com.yourname.action.DeptManageAction" method="input">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/dept/dept_edit.jsp</result>
            <result name="input" type="redirectAction">dept_list</result>
        </action>

        <action name="dept_save" class="com.yourname.action.DeptManageAction" method="save">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">dept_list</result>
            <result name="input">/WEB-INF/jsp/system/dept/dept_edit.jsp</result>
        </action>

        <action name="dept_delete" class="com.yourname.action.DeptManageAction" method="delete">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">dept_list</result>
            <result name="input" type="redirectAction">dept_list</result>
        </action>

        <!-- ===== 登录日志 ===== -->
        <action name="loginlog_list" class="com.yourname.action.LoginLogAction" method="list">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/loginlog/list.jsp</result>
        </action>

        <!-- ===== 操作日志 ===== -->
        <action name="operlog_list" class="com.yourname.action.OperLogAction" method="list">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/operlog/list.jsp</result>
        </action>

        <!-- ===== 修改密码（任何登录用户可用，不需要菜单权限） ===== -->
        <action name="password_input" class="com.yourname.action.PasswordAction" method="input">
            <interceptor-ref name="authStack"/>
            <result name="input">/WEB-INF/jsp/system/profile/password.jsp</result>
        </action>

        <action name="password_save" class="com.yourname.action.PasswordAction" method="save">
            <interceptor-ref name="authStack"/>
            <result name="input">/WEB-INF/jsp/system/profile/password.jsp</result>
            <result>/WEB-INF/jsp/system/profile/password.jsp</result>
            <!-- 改密成功后会话已失效，回登录页并给出提示 -->
            <result name="login" type="redirectAction">
                <param name="actionName">login_input</param>
                <param name="msg">changed</param>
            </result>
        </action>

        <!-- ===== 数据字典 ===== -->
        <action name="dict_type_list" class="com.yourname.action.DictManageAction" method="typeList">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/dict/type_list.jsp</result>
            <result name="input">/WEB-INF/jsp/system/dict/type_list.jsp</result>
        </action>

        <action name="dict_type_input" class="com.yourname.action.DictManageAction" method="typeInput">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/dict/type_edit.jsp</result>
            <result name="input" type="redirectAction">
                <param name="actionName">dict_type_list</param>
            </result>
        </action>

        <action name="dict_type_save" class="com.yourname.action.DictManageAction" method="typeSave">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">dict_type_list</result>
            <result name="input">/WEB-INF/jsp/system/dict/type_edit.jsp</result>
        </action>

        <action name="dict_type_delete" class="com.yourname.action.DictManageAction" method="typeDelete">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">dict_type_list</result>
            <result name="input">/WEB-INF/jsp/system/dict/type_list.jsp</result>
        </action>

        <action name="dict_data_list" class="com.yourname.action.DictManageAction" method="dataList">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/dict/data_list.jsp</result>
            <result name="input">/WEB-INF/jsp/system/dict/data_list.jsp</result>
        </action>

        <action name="dict_data_input" class="com.yourname.action.DictManageAction" method="dataInput">
            <interceptor-ref name="authStack"/>
            <result>/WEB-INF/jsp/system/dict/data_edit.jsp</result>
            <result name="input" type="redirectAction">
                <param name="actionName">dict_type_list</param>
            </result>
        </action>

        <action name="dict_data_save" class="com.yourname.action.DictManageAction" method="dataSave">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">
                <param name="actionName">dict_data_list</param>
                <param name="type">${type}</param>
            </result>
            <result name="input">/WEB-INF/jsp/system/dict/data_edit.jsp</result>
        </action>

        <action name="dict_data_delete" class="com.yourname.action.DictManageAction" method="dataDelete">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">
                <param name="actionName">dict_data_list</param>
                <param name="type">${type}</param>
            </result>
            <result name="input">/WEB-INF/jsp/system/dict/data_list.jsp</result>
        </action>

        <action name="dict_refresh" class="com.yourname.action.DictManageAction" method="refresh">
            <interceptor-ref name="authStack"/>
            <result name="success" type="redirectAction">dict_type_list</result>
        </action>

    </package>

    <!-- 按模块拆分配置时使用：
         <include file="struts/struts-user.xml"/>
         <include file="struts/struts-role.xml"/>
         <include file="struts/struts-dict.xml"/>
    -->

</struts>
